{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": "^22.11.0 || ^24.0.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2wheeh/lexical-footnote.git"
  },
  "scripts": {
    "build": "pnpm --filter lexical-footnote build",
    "dev": "pnpm --filter docs dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter lexical-footnote test",
    "test:browser": "pnpm --filter lexical-footnote test:browser",
    "test:all": "pnpm --filter lexical-footnote test:all",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^9.39.0",
    "@lexical/eslint-plugin": "~0.47.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.4"
  }
}
